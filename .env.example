# streamlit-keep-awake has no secrets of its own. Copy to .env only if you want to change the default.

# How many apps to open at the same time (default 3).
KEEPAWAKE_PARALLEL=3

# The daily failure summary workflow reads these from GitHub Actions secrets, never from a file in the repo:
#   OPS_DATABASE_URL   read access to the shared request log (Neon Postgres)
#   SLACK_WEBHOOK_URL  optional; posts the summary to Slack as well as opening an issue
